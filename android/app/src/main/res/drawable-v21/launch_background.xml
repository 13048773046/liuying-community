<?xml version="1.0" encoding="utf-8"?>
<!-- 流萤社区启动页（Android 5.0+）：深黑底 + 品牌内容图（圆角 Logo + 名称 + 标语）居中，
     与 drawable/launch_background 一致，无缝衔接 Flutter 首帧（不再用系统默认白屏）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_brand" />
    </item>
</layer-list>
